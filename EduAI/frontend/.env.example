# Public API base URL only; do not put provider API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Used by the server-side Project Information access gate.
# Replace both values locally; never commit .env.local or real credentials.
PROJECT_INFO_PASSWORD=replace-with-a-unique-long-password
PROJECT_INFO_SESSION_SECRET=replace-with-at-least-32-random-bytes

# AI provider credentials must be configured in the backend/server environment,
# not in this browser-facing Next.js project.
